# =============================================================================================
# Shared Environment Variables
# These will be used by all nodes
# ---------------------------------------------------------------------------------------------
INDY_NETWORK_NAME=bcovrin

INDY_NODE_IP=0.0.0.0
INDY_CLIENT_IP=0.0.0.0

NODE_CONTAINER_NAME=node
CONTROLLER_CONTAINER_NAME=controller
IMAGE_NAME_CONTROLLER=ghcr.io/hyperledger/indy-node-container/indy_node_controller:1.2.10

SOCK=${XDG_RUNTIME_DIR}/docker.sock

NODE_NETWORK=nodes
PROXY_NETWORK=proxy
