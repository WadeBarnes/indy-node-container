# =============================================================================================
# Node Specific Environment Variables
# These will be used by this node only
# ---------------------------------------------------------------------------------------------
INDY_NODE_NAME=LedgerMonitor
IMAGE=ghcr.io/bcgov/von-network-base:latest

# Use default - 9000
WEB_SERVER_HOST_PORT=9000

LOG_LEVEL=info
RUST_LOG=error

ENABLE_LEDGER_CACHE=False
ENABLE_BROWSER_ROUTES=False
POOL_CONNECTION_DELAY=20
POOL_CONNECTION_ATTEMPTS=30
GENESIS_FILE=/var/lib/indy/${INDY_NETWORK_NAME}/pool_transactions_genesis

LEDGER_INSTANCE_NAME=BCovrin Test
LEDGER_DESCRIPTION="Contributed by the Province of British Columbia"
INFO_SITE_TEXT=digital.gov.bc.ca/digital-trust
INFO_SITE_URL=https://digital.gov.bc.ca/digital-trust/
INDY_SCAN_URL=https://indyscan.bcovrin.vonx.io
INDY_SCAN_TEXT="IndyScan - BCovrin Test"
# =============================================================================================
